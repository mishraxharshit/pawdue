# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Project Settings -> API -> service_role key (SECRET - server-side only, never expose to browser)
# Used only by the cron job, which needs to read every groomer's dogs, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Twilio (SMS) ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# --- WhatsApp Cloud API (Meta) ---
# Get these from https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Email (Resend) ---
# Final fallback channel, tried if both WhatsApp and SMS fail or aren't set up yet.
# Get an API key free at https://resend.com (no card needed for the free tier)
RESEND_API_KEY=""
# While testing, "onboarding@resend.dev" works immediately, no domain setup needed.
# Before real launch, verify your own domain in Resend and use an address on it.
REMINDER_FROM_EMAIL="onboarding@resend.dev"
# Where the /feedback page's messages get emailed. Defaults to REMINDER_FROM_EMAIL
# if unset - set this to your own inbox to receive feedback separately.
FEEDBACK_TO_EMAIL=""

# --- App ---
# Your app's own base URL - used to build each dog's unique booking page link
# (yoursite.com/book/<token>). Locally this is your dev URL; in Vercel, your real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron protection ---
# Random string; set the same value in Vercel's Cron Job settings / env vars.
CRON_SECRET="replace-with-a-random-secret"
# Where to send an alert email if the reminder cron crashes or every send in
# a batch fails - without this, a broken cron fails completely silently.
# Falls back to FEEDBACK_TO_EMAIL, then REMINDER_FROM_EMAIL, if unset.
OPS_ALERT_EMAIL=""

# --- Dodo Payments (billing) ---
# Get this from https://app.dodopayments.com -> Developer > API (use test_mode while developing)
DODO_PAYMENTS_API_KEY="..."
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# From Developer > Webhooks after adding your webhook endpoint
DODO_PAYMENTS_WEBHOOK_KEY="..."
# Create two Products in the Dodo dashboard (Starter $29/mo, Pro $49/mo) and paste their Product IDs here
DODO_STARTER_PRODUCT_ID="pdt_..."
DODO_PRO_PRODUCT_ID="pdt_..."
